source "https://rubygems.org"

# Mirrors the classic GitHub Pages server-side build exactly: github-pages
# already exact-pins jekyll-feed, jekyll-sitemap, jekyll-gist,
# jekyll-redirect-from, jekyll-paginate and jemoji, so those aren't listed
# separately here (doing so just fights the resolver for no benefit).
gem "github-pages", group: :jekyll_plugins

# Windows/JRuby only; macOS reads the system zoneinfo database.
gem "tzinfo-data", platforms: [:windows, :jruby]

gem "webrick", "~> 1.8"
